# The decider: OpenAI's Decisions API (typed questions, /v1/decisions). When set, it is the default sensor.
OPENAI_API_KEY=
# ANYGAME_DECISIONS_MODEL=gpt-6-luna
# Jev (always OpenRouter or JEV_BASE_URL): --sensor jev, or the default when OPENAI_API_KEY is unset
OPENROUTER_API_KEY=
# Everything that is not Jev: the authoring model and llm:<model> sensors
ANYGAME_LLM_BASE=https://<resource>.openai.azure.com
ANYGAME_LLM_KEY=
ANYGAME_LLM_MODEL=<deployment name>
ANYGAME_LLM_API_VERSION=2024-10-21
